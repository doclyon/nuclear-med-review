# === API Anthropic (Claude) ===
# Obtenir sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# === API NCBI/PubMed ===
# Obtenir sur : https://www.ncbi.nlm.nih.gov/account/settings/ (section API Key Management)
# Permet 10 requetes/s au lieu de 3
PUBMED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# === SMTP Gmail ===
# SMTP_USER : ton adresse Gmail complete
# SMTP_PASSWORD : App Password genere sur https://myaccount.google.com/apppasswords
#   (la double authentification doit etre activee sur le compte Gmail)
SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# === Destinataire de la revue ===
RECIPIENT_EMAIL=ton.email@gmail.com

# === Optionnel : URL publique de l'archive GitHub Pages ===
# Format : https://<user>.github.io/nuclear-med-review
# Utilisee dans l'email pour pointer vers la revue en ligne
PUBLIC_ARCHIVE_URL=https://ton-user.github.io/nuclear-med-review
